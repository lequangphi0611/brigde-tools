{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test:*)",
      "Bash(pnpm test)",
      "Bash(pnpm e2e)",
      "Bash(pnpm e2e e2e/specs/*)",
      "Bash(pnpm e2e:lock:check)",
      "Bash(pnpm verify)",
      "Bash(pnpm build)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout -b:*)"
    ],
    "deny": [
      "Edit(e2e/specs.lock.json)",
      "Write(e2e/specs.lock.json)"
    ],
    "ask": [
      "Bash(pnpm e2e:lock)",
      "Bash(node scripts/e2e-lock.mjs write)"
    ]
  }
}
